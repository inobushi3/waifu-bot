# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set this while developing so slash commands appear immediately
DISCORD_GUILD_ID=

# ComfyUI running on the same machine as the bot
COMFY_URL=http://127.0.0.1:8188

# Export your ComfyUI workflow using "Export (API)"
WORKFLOW_PATH=./workflow_api.json

# Optional overrides for unusual/custom workflows.
# Normally Waifu-bot detects these automatically.
SAMPLER_NODE_ID=
POSITIVE_NODE_ID=
NEGATIVE_NODE_ID=

# Optional: restrict image generation to one Discord channel
ALLOWED_CHANNEL_ID=

# Maximum time to wait for one ComfyUI job
GENERATION_TIMEOUT_MS=600000
